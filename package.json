{
  "name": "fastify-api-rest",
  "version": "1.0.0",
  "description": "A backend server was created using Fastify to learn about the framework and the development environment. Testing will be performed, and the project as a whole will be done to the best of my ability.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "knex": "node --import tsx ./node_modules/knex/bin/cli.js",
    "lint:fix": "npx eslint . --fix",
    "build": "tsup src --out-dir build",
    "test": "vitest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucas-Gonsalves/fastify-api-rest.git"
  },
