  "bugs": {
    "url": "https://github.com/Lucas-Gonsalves/fastify-api-rest/issues"
  },
  "homepage": "https://github.com/Lucas-Gonsalves/fastify-api-rest#readme",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
